# --- Admin local (optionnel, déjà configuré pour apatchegaming@gmail.com) ---
VITE_ADMIN_EMAIL=admin@ztc.shop
VITE_ADMIN_PASSWORD=change-moi-maintenant

# --- Backend partagé Supabase (commandes/comptes/produits en temps réel) ---
# 1. Crée un projet gratuit sur https://supabase.com/dashboard
# 2. SQL Editor > colle supabase-schema.sql > Run
# 3. Auth > Providers > Email : désactive "Confirm email"
# 4. Project Settings > API : copie URL + anon key ici (et dans Netlify > Environment variables)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Recrutement Esport : notif Discord des candidatures (/recrutement) ---
# VITE_DISCORD_RECRUTEMENT_WEBHOOK=https://discord.com/api/webhooks/XXXX/YYYY
# --- Notifications push système (Web Push VAPID, gratuit) ---
# VITE_VAPID_PUBLIC_KEY=
# (clé privée -> supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=mailto:...)
# --- OAuth direct (optionnel, mode démo sinon) ---
# VITE_DISCORD_CLIENT_ID=
# VITE_FACEBOOK_APP_ID=
